# Run node scripts/configure.mjs to generate private local credentials.
POSTGRES_PASSWORD=replace-with-your-local-password
ConnectionStrings__Insurance=Host=127.0.0.1;Port=55462;Database=insurance_interview;Username=insurance_interview;Password=replace-with-your-local-password;Maximum Pool Size=10
ASPNETCORE_URLS=http://127.0.0.1:5081
ASPNETCORE_ENVIRONMENT=Development
FrontendUrl=http://localhost:3001
Operator__Email=operator@insurance.demo
Operator__Password=replace-with-your-own-strong-password
# Optional Gemini assistant. Leave the key empty to show a truthful unavailable state.
Gemini__ApiKey=
Gemini__Model=gemini-3.5-flash

# Optional local customer fixture. Refused outside Development; never grants operator access.
DemoAccount__Username=
DemoAccount__Password=
